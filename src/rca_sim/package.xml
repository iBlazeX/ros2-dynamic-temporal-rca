<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rca_sim</name>
  <version>0.1.0</version>
  <description>Lightweight kinematic mobile-robot simulation (LiDAR, camera, IMU, odometry, perception, localization, planning, control) with runtime degradation mechanisms; second experimental environment for the dynamic temporal RCA monitor.</description>
  <maintainer email="lynx@todo.todo">lynx</maintainer>
  <license>Apache-2.0</license>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <exec_depend>diagnostic_monitor</exec_depend>
  <exec_depend>rca_test_system</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
