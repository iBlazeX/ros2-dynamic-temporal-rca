<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>diagnostic_tui</name>
  <version>0.1.0</version>
  <description>Live terminal dashboard (FTXUI) for the diagnostic_monitor RCA state. Visualisation only: subscribes to /rca/dashboard_state and renders it; contains no RCA logic.</description>
  <maintainer email="lynx@todo.todo">lynx</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>nlohmann-json-dev</depend>

  <exec_depend>diagnostic_monitor</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
